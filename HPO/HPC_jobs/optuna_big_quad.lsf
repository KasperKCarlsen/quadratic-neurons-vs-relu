cd ~/Fagprojekt

echo "Job started at $(date)"
echo "Running on node: $(hostname)"

source .optuna/bin/activate

python HPO/Train_Model.py --model Quad_neuron --ReLU 2 --epoch 100 --num_blocks 18 18 18
python HPO/Train_Model.py --model Quad_neuron --ReLU 1 --epoch 100 --num_blocks 18 18 18
python HPO/Train_Model.py --model Quad_neuron --ReLU 0 --epoch 100 --num_blocks 18 18 18

echo "Job finished at $(date)"
