set -euo pipefail
cd ~/Fagprojekt
mkdir -p logs optuna_databases
NUM_WORKERS=3

pids=()
for i in $(seq 1 "$NUM_WORKERS"); do
    python Finetune.py \
        --only "Quad_neuron_with_ReLU0arc(5_5_5)" \
        --seeds 0 1 2 3 4 \
        --epochs 200 \
    pids+=($!)
done


