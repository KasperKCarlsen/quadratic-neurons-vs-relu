#!/bin/bash
# =====================================================================
# Multi-worker Optuna HPO on ONE A100 via NVIDIA MPS.
#
# A ResNet-20-class trial uses <2GB VRAM and a small fraction of an A100,
# so a single trial leaves the GPU mostly idle. Instead of trying to make
# one trial faster, we run NUM_WORKERS Optuna processes CONCURRENTLY on the
# same physical GPU. NVIDIA's Multi-Process Service (MPS) lets processes in
# the SAME job share one card (DTU documents exactly this: mps=yes).
#
# All workers attach to ONE shared Optuna study (journal storage +
# create_study(load_if_exists=True)), so:
#       total trials = NUM_WORKERS x TRIALS_PER_WORKER
# Each trial's artifacts go to models/.../trial<N>, scoped by the study's
# global trial.number, so concurrent workers never clobber each other.
#
# Submit from the repo root:
#     mkdir -p logs && bsub < submit_hpo_mps.lsf
# =====================================================================

### --- LSF directives ----------------------------------------------
#BSUB -J quad_mps
#BSUB -q gpua100                                  # A100 queue; verify with `bqueues`
#BSUB -gpu "num=1:mode=exclusive_process:mps=yes" # mps=yes -> processes in THIS job share the GPU
#BSUB -n 12                                        # 4 cores/worker x 3 workers. DTU's MPS example uses 12.
                                                   # Keep total <=16 so the node's 2nd A100 stays usable.
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=2GB]"                         # per-CORE -> 24GB total. Trim after checking `bstat -M`.
#BSUB -W 12:00                                     # walltime HH:MM (GPU cap is 24:00). Trim for backfill once timed.
#BSUB -o logs/quad_mps_%J.out                      # job-level stdout (worker output is redirected separately below)
#BSUB -e logs/quad_mps_%J.err
#BSUB -B
#BSUB -N
#BSUB -u s234813@dtu.dk
# NOTE: no `select[gpu80gb]` -> both 40GB and 80GB A100 nodes stay eligible -> admitted sooner.
### ------------------------------------------------------------------

set -euo pipefail

cd ~/Fagprojekt
mkdir -p logs optuna_databases

# ---- experiment config (edit these) ---------------------------------
NUM_WORKERS=3                 # processes sharing the one GPU. Raise carefully: watch VRAM + cores.
MODEL=Quad_neuron
RELU=2
BLOCKS=(3 3 3)                # ResNet-20-scale. (18 18 18) is the heavy variant.
EPOCHS=40
TRIALS_PER_WORKER=25          # total trials = NUM_WORKERS x this = 75 here
# ---------------------------------------------------------------------

echo "Job ${LSB_JOBID:-?} started $(date) on $(hostname) | workers=${NUM_WORKERS}"

# --- Environment -----------------------------------------------------
# module load cuda/12.4    # uncomment ONLY if torch can't see the GPU; pip-torch bundles its own CUDA
source .optuna/bin/activate
# source ~/miniconda3/etc/profile.d/conda.sh && conda activate cifar   # conda alternative

# Split the granted cores across workers so the N processes don't oversubscribe
# the CPU (N workers x all-cores each = thrash). Floor at 1.
NPROC=${LSB_DJOB_NUMPROC:-12}
THREADS=$(( NPROC / NUM_WORKERS ))
[ "$THREADS" -lt 1 ] && THREADS=1
export OMP_NUM_THREADS=$THREADS
export MKL_NUM_THREADS=$THREADS


# --- Launch workers --------------------------------------------------
# Every worker runs the SAME command (--storage journal + load_if_exists in
# Train_Model.py makes workers 2..N JOIN the study worker 1 created). Each
# worker's stdout/stderr is redirected to its own file: MPS merges streams
# otherwise (per DTU's note), making logs unreadable.
pids=()
for i in $(seq 1 "$NUM_WORKERS"); do
    python Train_Model.py \
        --model "$MODEL" \
        --ReLU "$RELU" \
        --num_blocks "${BLOCKS[@]}" \
        --epoch "$EPOCHS" \
        --n_trials "$TRIALS_PER_WORKER" \
        --storage journal \
        > "logs/${MODEL}_mps_${LSB_JOBID:-0}_w${i}.out" \
        2> "logs/${MODEL}_mps_${LSB_JOBID:-0}_w${i}.err" &
    pids+=($!)
    echo "  launched worker $i (pid $!)"
    sleep 5   # small stagger: lets worker 1 lead on study creation / first compile
done

# --- Wait + report ---------------------------------------------------
# Wait on each PID individually so one failed worker (e.g. CUDA OOM if you
# over-pack the GPU) is reported but the others still finish their trials.
fail=0
for idx in "${!pids[@]}"; do
    pid=${pids[$idx]}
    if ! wait "$pid"; then
        echo "WARNING: worker $((idx+1)) (pid $pid) exited non-zero -> see its .err log"
        fail=1
    fi
done

echo "Job finished $(date) | any_worker_failed=${fail}"
exit "$fail"
