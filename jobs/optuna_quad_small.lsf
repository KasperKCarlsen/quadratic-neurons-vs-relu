#!/bin/bash
### ---- LSF options -------------------------------------------------
#BSUB -J Quad_b5
#BSUB -q gpua100
#BSUB -gpu "num=1:mode=exclusive_process"   # REQUEST A GPU (your originals were missing this)
#BSUB -n 4                                   # >=4 cores/GPU per DTU's GPU guide (was -n 1)
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=4GB]"                    # per-CORE -> 16GB total (was 32GB on 1 core). Trim via `bstat -M`.
#BSUB -W 24:00                         # GPU queues cap at 24:00 (your originals' 72:00 is rejected)
#BSUB -o logs/Quad_b5_%J.out                  # relative path (your originals' /logs is the root FS, unwritable)
#BSUB -e logs/Quad_b5_%J.err
#BSUB -B
#BSUB -N
#BSUB -u s234813@dtu.dk
### ------------------------------------------------------------------

set -euo pipefail

cd ~/Fagprojekt
mkdir -p logs

# ---- experiment config (edit these) ----
MODEL=Quad_neuron
BLOCKS=(5 5 5)
EPOCHS=100
TRIALS=100        # total work = TRIALS x EPOCHS x 3 ReLU values. See note re: the 24h cap.
COMPILE=reduce-overhead      # 'reduce-overhead' for a speedup (validate with test.lsf first); 'none' is the safe fallback
# -----------------------------------------

echo "Job ${LSB_JOBID:-?} started $(date) on $(hostname)"

# module load cuda/12.4   # uncomment ONLY if torch can't see the GPU / you need nvcc; pip-torch bundles its own CUDA
source .optuna/bin/activate

# Give the math libraries the cores LSF actually granted, and persist torch.compile's
# kernel cache on the shared home FS so the per-trial compile is paid once, then reused.
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export MKL_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export TORCHINDUCTOR_CACHE_DIR="$HOME/Fagprojekt/.inductor_cache"
export TORCHINDUCTOR_FX_GRAPH_CACHE=1
mkdir -p "$TORCHINDUCTOR_CACHE_DIR"

# One study per ReLU value, run sequentially. If a job hits the 24h wall it is killed,
# but completed Optuna trials are saved; resubmitting this same script resumes each study
# (create_study uses load_if_exists) from where it stopped.
for relu in 2 1 0; do
    echo ">>> $MODEL  ReLU=$relu  blocks=${BLOCKS[*]}  ($(date))"
    python Train_Model.py \
        --model "$MODEL" \
        --ReLU "$relu" \
        --epoch "$EPOCHS" \
        --num_blocks "${BLOCKS[@]}" \
        --n_trials "$TRIALS" \
        --compile "$COMPILE"
done

echo "Job finished $(date)"
